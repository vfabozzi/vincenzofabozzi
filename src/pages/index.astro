---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import SelectedWorks from "../components/SelectedWorks.jsx";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { processMedia } from "../lib/processMedia";

const entries = await getCollection("projects", ({ data }) => data.published);

const projects = await Promise.all(
	entries
		.sort((a, b) => a.data.order - b.data.order)
		.map(async ({ id, data }) => ({
			id,
			...data,
			media: await processMedia(data.media),
		})),
);
---

<Layout>
	<Header />
	<SelectedWorks client:load projects={projects} />
	<Footer />
	<Nav />
</Layout>
